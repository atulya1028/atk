{
  "name": "atk-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "prestart": "prisma generate",
    "predev": "prisma generate",
    "migrate": "prisma migrate deploy",
    "db:seed-questions": "node src/seed_survey_questions.js",
    "studio": "prisma studio --config ./prisma.config.ts",
    "check": "node --check src/server.js",
    "db:generate": "prisma generate"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.6.0",
    "pg": "^8.16.3",
    "prisma": "^7.10.1",
    "zod": "^4.1.5"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  },
  "devDependencies": {}
}
