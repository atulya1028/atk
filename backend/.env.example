PORT=8080
NODE_ENV=development
DATABASE_URL=postgres://atk:atk_local_password@localhost:5432/atk
# For Prisma Postgres: pooled URL for the API, direct URL for migrations. Leave blank for local PostgreSQL.
DIRECT_URL=
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Set to 1 only when the API is behind one trusted reverse proxy/load balancer.
TRUST_PROXY=0
APP_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:5001,http://127.0.0.1:5001,http://localhost:3000,http://localhost:8080
# SMTP credentials for real email OTP delivery. Use a transactional email provider.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
OTP_FROM_EMAIL=ATK <no-reply@your-verified-domain.com>
